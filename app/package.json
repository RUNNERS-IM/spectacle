{
  "name": "split",
  "productName": "Split",
  "private": true,
  "version": "2.6.1031+2",
  "description": "Window arranging app by RUNNERS",
  "author": "RUNNERS",
  "homepage": "https://github.com/RUNNERS-IM/split",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "native": "napi build --manifest-path native/Cargo.toml --package-json-path native/package.json --platform --release --output-dir native --no-js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "tsx --test test/core/*.test.ts",
    "dist:mac": "pnpm run native:mac-universal && electron-vite build && electron-builder --mac --config builder.config.cjs",
    "native:mac-universal": "sh scripts/native-mac-universal.sh",
    "dist:win": "pnpm run native && electron-vite build && electron-builder --win --config builder.config.cjs",
    "dist:linux": "pnpm run native && electron-vite build && electron-builder --linux --config builder.config.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.8.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.63.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
