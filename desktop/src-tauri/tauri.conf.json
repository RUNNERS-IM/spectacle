{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Split",
  "version": "0.1.0",
  "identifier": "im.runners.split",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Split Settings",
        "width": 600,
        "height": 700,
        "minWidth": 520,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Move and resize windows with keyboard shortcuts",
    "longDescription": "Split moves and resizes the focused window with keyboard shortcuts: halves, corners, thirds, other monitors, and arranging every visible window at once.",
    "copyright": "RUNNERS",
    "license": "MIT",
    "homepage": "https://github.com/RUNNERS-IM/split",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
